@model List<HealthcareShoppingCart.Models.Product>
@{
    ViewData["Title"] = "My Healthcare Products";
}

<div class="page-header mb-4">
    <h1 class="display-5 fw-bold text-primary">Healthcare Products</h1>
    <p class="lead text-muted">Browse our curated selection of healthcare essentials and add them to your cart.</p>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    @foreach (var product in Model)
    {
        <div class="col-md-6 col-lg-4 col-xl-3">
            <div class="card product-card h-100 shadow-sm">
                <div class="product-image-wrapper">
                    <img src="@product.ImageUrl" class="card-img-top product-image" alt="@product.Name" />
                    <span class="badge bg-primary category-badge">@product.Category</span>
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text text-muted small flex-grow-1">@product.Description</p>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="price-tag">$@product.Price.ToString("F2")</span>
                        <form asp-action="AddToCart" method="post" class="d-flex align-items-center gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@product.Id" />
                            <input type="number" name="quantity" value="1" min="1" max="10" class="form-control form-control-sm qty-input" />
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="bi bi-cart-plus"></i> Add
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
